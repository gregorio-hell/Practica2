<link rel="stylesheet" href="~/css/catalogo.css" />
@model dynamic
@{
    ViewData["Title"] = "Agendar Visita";
    var inmueble = ViewBag.Inmueble;
}
<div class="catalogo-card" style="max-width:500px;margin:auto;">
    <h2 style="margin-bottom:1rem;">Agendar visita para <span style="color:#7c3aed;">@inmueble.Titulo</span></h2>
    <form asp-action="AgendarVisita" method="post" style="display:flex;flex-direction:column;gap:1rem;">
        <input type="hidden" name="id" value="@inmueble.Id" />
        <div class="filtro-group" style="width:100%;">
            <label><i class="fa fa-calendar"></i>Fecha Inicio:</label>
            <input type="datetime-local" name="FechaInicio" required class="form-control" style="width:100%;" />
        </div>
        <div class="filtro-group" style="width:100%;">
            <label><i class="fa fa-calendar"></i>Fecha Fin:</label>
            <input type="datetime-local" name="FechaFin" required class="form-control" style="width:100%;" />
        </div>
        <div class="filtro-group" style="width:100%;">
            <label><i class="fa fa-pencil"></i>Notas:</label>
            <textarea name="Notas" class="form-control" style="width:100%;"></textarea>
        </div>
        <div asp-validation-summary="All"></div>
        <button type="submit" class="btn btn-primary" style="width:100%;background:#7c3aed;border:none;border-radius:2rem;font-weight:600;">Agendar</button>
    </form>
</div>
