@model pc2.Models.Inmueble

@{
    ViewData["Title"] = "Detalles del Inmueble";
}

<div class="container mt-4">
    <h1>Detalles del Inmueble</h1>

    <div class="card">
        <div class="card-header">
            <h3>@Model.Titulo</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    @if (!string.IsNullOrEmpty(Model.Imagen))
                    {
                        <img src="@Model.Imagen" class="img-fluid" alt="@Model.Titulo" />
                    }
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Codigo)</dt>
                        <dd class="col-sm-8">@Model.Codigo</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Precio)</dt>
                        <dd class="col-sm-8">@Model.Precio.ToString("C")</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Ciudad)</dt>
                        <dd class="col-sm-8">@Model.Ciudad</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Direccion)</dt>
                        <dd class="col-sm-8">@Model.Direccion</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Tipo)</dt>
                        <dd class="col-sm-8">@Model.Tipo</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Dormitorios)</dt>
                        <dd class="col-sm-8">@Model.Dormitorios</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Banos)</dt>
                        <dd class="col-sm-8">@Model.Banos</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MetrosCuadrados)</dt>
                        <dd class="col-sm-8">@Model.MetrosCuadrados m²</dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">
                            @if(Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver al Panel</a>
        </div>
    </div>
</div>